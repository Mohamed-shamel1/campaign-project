# WAPilot API v2 Configuration for Vercel Serverless Functions
# Add these variables in Vercel Dashboard -> Project Settings -> Environment Variables

# The secret API Bearer token provided by WAPilot
WAPILOT_API_KEY=your_wapilot_secret_api_key_here

# The WhatsApp instance ID connected in your WAPilot dashboard
WAPILOT_INSTANCE_ID=your_instance_id_here

# Base URL for WAPilot API v2 (defaults to https://api.wapilot.net/v2 if omitted)
WAPILOT_API_URL=https://api.wapilot.net/v2

